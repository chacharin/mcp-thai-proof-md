# =============================================================================
# mcp-thai-proofread — MCP server ตรวจและแก้คำสะกดภาษาไทยด้วย LLM — ตัวอย่างไฟล์ .env
# เครื่องมือ: proofread_thai (แก้ไฟล์ใน workspace) และ proofread_text (ตรวจข้อความ ไม่แตะไฟล์)
# -----------------------------------------------------------------------------
# ไฟล์นี้คือคู่มือของทุกค่าที่ปรับได้ แบ่งเป็น 4 หมวดเดียวกับ .env
# .env ของคุณใส่เฉพาะค่าที่ไม่มี # นำหน้า (ต้องตั้ง) และค่าที่ต้องการให้ต่างจากค่าเริ่มต้น
# ค่าที่มี # นำหน้าคือค่าเริ่มต้น — ไม่ใส่ใน .env ก็ใช้ค่านี้
# แก้ .env แล้วต้องสร้าง container ใหม่: docker compose up -d
# =============================================================================

# --- LLM ---
# endpoint แบบ OpenAI-compatible (/chat/completions) เช่น OpenRouter, vLLM, Ollama (http://host:11434/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
# API key (ค่าลับ) — เว้นว่างได้ถ้า endpoint ไม่ต้องใช้ key (เช่น Ollama ในเครื่อง)
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# model ที่เก่งภาษาไทย คุณภาพการแก้ขึ้นกับ model นี้โดยตรง
LLM_MODEL=google/gemma-4-31b-it
# เวลารอ LLM ต่อหนึ่งช่วงข้อความ (วินาที) — model ใหญ่หรือรายงานยาว แนะนำ 600
# LLM_TIMEOUT_SECONDS=180
# จำนวนช่วงข้อความที่ส่งให้ LLM พร้อมกัน — ถ้าเจอ rate limit (HTTP 429) บ่อย ให้ลดลง
# WORKERS=4
# ชื่อแอปในสถิติการใช้งานของ OpenRouter (header X-Title) — ว่าง = ไม่ส่ง
# LLM_APP_TITLE=
# เว็บไซต์อ้างอิงในสถิติของ OpenRouter (header HTTP-Referer) — ว่าง = ไม่ส่ง
# LLM_HTTP_REFERER=
# ความสุ่มของคำตอบ — 0 = แก้แบบคงที่ ไม่แต่งเพิ่ม
# LLM_TEMPERATURE=0
# จำนวน token สูงสุดที่ LLM ตอบกลับต่อหนึ่งช่วงข้อความ
# LLM_MAX_TOKENS=8000
# จำนวนครั้งที่ลองใหม่เมื่อเรียก LLM ไม่สำเร็จ (เฉพาะ 408/409/429/5xx และเครือข่ายขัดข้อง)
# LLM_RETRIES=3
# ค่าเพิ่มเติมที่ส่งไปกับทุก request เป็น JSON object หนึ่งบรรทัด (ห้ามตั้ง model หรือ messages)
#   เช่น {"top_p": 0.9} หรือ OpenRouter {"provider": {"order": ["google-vertex"]}} — JSON ผิด ระบบจะไม่เริ่มทำงาน
# LLM_EXTRA_PARAMS=

# --- prompt และกฎกันแก้เกิน ---
# ไฟล์ system prompt ที่ใช้แทน prompt ในตัว (path ภายใน container — โฟลเดอร์ ./prompts ถูก mount ไว้ที่ /app/prompts)
#   คัดลอก prompts/system_prompt.example.md เป็นไฟล์ใหม่แล้วแก้ตามงาน เช่น เอกสารราชการ กฎหมาย การแพทย์
#   prompt ต้องสั่งให้คืนจำนวนบรรทัดเท่าเดิม เรียงตามเดิม ไม่มีคำอธิบาย ไม่เช่นนั้นการแก้จะถูกปฏิเสธ
#   ว่าง = ใช้ prompt ในตัว · ถ้าตั้งแล้วหาไฟล์ไม่เจอหรือไฟล์ว่าง ระบบจะไม่เริ่มทำงาน
# SYSTEM_PROMPT_FILE=
# regex ของรหัสที่ห้ามเปลี่ยน — บรรทัดที่ LLM แก้แล้วรหัสเหล่านี้ไม่ตรงเดิมจะถูกปฏิเสธ
#   ค่าเริ่มต้นจับรหัสอ้างอิงแบบ [S1] [F12] [S3a] · รวมหลายแบบด้วย | เช่น \[[A-Z]{1,3}\d+\]|มาตรา\s?\d+
#   ไม่ต้องใส่เครื่องหมายคำพูด · ว่าง = ไม่ตรวจรหัส (ตัวเลข URL และคำภาษาอังกฤษยังถูกตรวจเสมอ)
# PROTECTED_REGEX=\[[A-Z]{1,3}\d+[a-z]?\]
# บรรทัดที่แก้แล้วต้องเหมือนต้นฉบับอย่างน้อยเท่านี้ (0–1) กัน LLM เขียนใหม่ทั้งบรรทัด
# MIN_SIMILARITY=0.5
# จำนวนตัวอักษรสูงสุดของหนึ่งช่วงข้อความ (ขึ้นช่วงใหม่ทุกหัวข้อด้วย)
# CHUNK_CHARS=3500
# จำนวนบรรทัดข้างเคียงที่ส่งไปเป็นบริบท (LLM อ่านได้แต่ไม่แก้)
# CONTEXT_LINES=3

# --- ทำงานร่วมกับเอเจนต์ ---
# คำนำหน้า path ที่เอเจนต์อาจส่งมา ระบบจะตัดออกก่อนหาไฟล์ (คั่นด้วย ,)
#   ใช้เมื่อเอเจนต์อ้างถึงไฟล์ด้วย path ของเครื่องตัวเอง เช่น Hermes ส่ง /opt/data/workspace/report.md
# PATH_PREFIXES=
# ที่เก็บไฟล์สำรองและบันทึกการแก้
#   file = ในโฟลเดอร์เดียวกับไฟล์ที่แก้   ·   top = ในโฟลเดอร์ชั้นแรกใต้ workspace (รวมไว้ที่เดียวต่อหนึ่งโปรเจกต์)
# OUTPUT_PLACEMENT=file
# นามสกุลไฟล์ที่ proofread_thai ยอมแก้ คั่นด้วย , (ระบบเข้าใจโครงสร้าง Markdown จึงเหมาะกับ .md ที่สุด)
# FILE_EXTENSIONS=.md
# ชื่อโฟลเดอร์ย่อยของไฟล์สำรอง (ปิดไม่ได้ — ทุกการแก้มีสำรองเสมอ)
# BACKUP_SUBDIR=backups
# ชื่อโฟลเดอร์ย่อยของบันทึกการแก้ — ว่าง = ไม่เขียนบันทึก
# NOTES_SUBDIR=notes
# เขตเวลาที่ใช้ตั้งชื่อไฟล์สำรองและหัวบันทึก แบบ POSIX (image ไม่มี tzdata) เช่น <+00>0 = UTC
# TZ=<+07>-7
# ถ้าตั้ง เอเจนต์ต้องส่ง "Authorization: Bearer <ค่านี้>" ทุกครั้ง (ค่าลับ)
#   ว่าง = ไม่ตรวจ — ⚠ ถ้าเปิดพอร์ตให้เครื่องอื่น ทุกคนในเครือข่ายสั่งแก้ไฟล์ใน workspace ได้
# MCP_AUTH_TOKEN=

# --- docker compose ---
# โฟลเดอร์ workspace บนเครื่อง (mount แบบเขียนได้ เพราะระบบแก้ไฟล์ให้)
# WORKSPACE_HOST_DIR=./workspace
# uid/gid ที่ container ใช้ — ให้ตรงกับเจ้าของ workspace เพื่อให้ไฟล์ที่แก้ยังเขียนต่อได้ทั้งสองฝั่ง
# RUN_UID=1000
# RUN_GID=1000
# docker network ที่ใช้ร่วมกับเอเจนต์ (ต้องสร้างก่อน: docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเรียกได้ · 127.0.0.1 = เฉพาะเครื่องนี้
# PUBLISH_ADDR=0.0.0.0
# พอร์ตบนเครื่อง
# PUBLISH_PORT=8805
