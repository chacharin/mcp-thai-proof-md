# =============================================================================
# mcp-thai-proofread — MCP server ตรวจและแก้คำสะกดภาษาไทยด้วย LLM — ตัวอย่างไฟล์ .env
# เครื่องมือ: proofread_thai (แก้ไขไฟล์ใน workspace) และ proofread_text (ตรวจข้อความโดยไม่แตะไฟล์)
# -----------------------------------------------------------------------------
# ไฟล์นี้อธิบายการตั้งค่าทั้งหมดที่ปรับได้ โดยแบ่งเป็น 5 หมวดเช่นเดียวกับไฟล์ .env
# บรรทัดที่ไม่มี # นำหน้าคือค่าที่จำเป็นต้องกำหนดในไฟล์ .env
# บรรทัดที่มี # นำหน้าคือค่าเริ่มต้น หากไม่กำหนดในไฟล์ .env ระบบจะใช้ค่านี้
# เมื่อแก้ไขไฟล์ .env แล้ว ให้สั่ง docker compose up -d เพื่อสร้าง container ใหม่
# =============================================================================

# --- LLM ---
# endpoint แบบ OpenAI-compatible (/chat/completions) เช่น OpenRouter, vLLM หรือ Ollama (http://host:11434/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
# API key (ค่าลับ) เว้นว่างได้หาก endpoint ไม่ต้องใช้ key เช่น Ollama ที่ติดตั้งในเครื่อง
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# model ที่รองรับภาษาไทยได้ดี คุณภาพการแก้ไขขึ้นอยู่กับ model นี้โดยตรง
LLM_MODEL=google/gemma-4-31b-it
# เวลารอ LLM ต่อหนึ่งช่วงข้อความ (วินาที) แนะนำ 600 สำหรับ model ขนาดใหญ่หรือรายงานยาว
# LLM_TIMEOUT_SECONDS=180
# จำนวนช่วงข้อความที่ส่งให้ LLM พร้อมกัน หากพบ rate limit (HTTP 429) บ่อย ให้ลดค่านี้ลง
# WORKERS=4
# ชื่อแอปที่แสดงในสถิติการใช้งานของ OpenRouter (header X-Title) หากเว้นว่างจะไม่ส่ง
# LLM_APP_TITLE=
# เว็บไซต์อ้างอิงที่แสดงในสถิติการใช้งานของ OpenRouter (header HTTP-Referer) หากเว้นว่างจะไม่ส่ง
# LLM_HTTP_REFERER=
# ระดับความสุ่มของคำตอบ ค่า 0 ทำให้ LLM แก้ไขอย่างคงที่และไม่เพิ่มเนื้อหาเอง
# LLM_TEMPERATURE=0
# จำนวน token สูงสุดที่ LLM ตอบกลับได้ต่อหนึ่งช่วงข้อความ
# LLM_MAX_TOKENS=8000
# จำนวนครั้งที่ลองใหม่เมื่อเรียก LLM ไม่สำเร็จ (เฉพาะ HTTP 408, 409, 429, 5xx และเมื่อเครือข่ายขัดข้อง)
# LLM_RETRIES=3
# ค่าเพิ่มเติมที่ส่งไปพร้อมทุกคำขอ ในรูปแบบ JSON object บรรทัดเดียว (ห้ามกำหนด model หรือ messages)
#   เช่น {"top_p": 0.9} หรือสำหรับ OpenRouter {"provider": {"order": ["google-vertex"]}}
#   หากรูปแบบ JSON ไม่ถูกต้อง ระบบจะไม่เริ่มทำงาน
# LLM_EXTRA_PARAMS=

# --- prompt และการป้องกันการแก้ไขเกินขอบเขต ---
# ไฟล์ system prompt ที่ใช้แทน prompt ที่มากับระบบ (ระบุ path ภายใน container โดยโฟลเดอร์ ./prompts ถูก mount ไว้ที่ /app/prompts)
#   คัดลอก prompts/system_prompt.example.md เป็นไฟล์ใหม่ แล้วปรับให้เหมาะกับงาน เช่น เอกสารราชการ กฎหมาย หรือการแพทย์
#   prompt ต้องสั่งให้ LLM ส่งกลับบรรทัดในจำนวนและลำดับเดิม โดยไม่มีคำอธิบาย มิฉะนั้นระบบจะปฏิเสธการแก้ไข
#   หากเว้นว่างจะใช้ prompt ที่มากับระบบ หากกำหนดแล้วแต่ไม่พบไฟล์หรือไฟล์ว่าง ระบบจะไม่เริ่มทำงาน
# SYSTEM_PROMPT_FILE=
# regex ของรหัสที่ห้ามเปลี่ยน หากบรรทัดที่ LLM แก้ไขมีรหัสเหล่านี้ไม่ตรงกับต้นฉบับ ระบบจะปฏิเสธการแก้ไข
#   ค่าเริ่มต้นตรวจรหัสอ้างอิงรูปแบบ [S1] [F12] [S3a] และรวมหลายรูปแบบได้ด้วย | เช่น \[[A-Z]{1,3}\d+\]|มาตรา\s?\d+
#   ไม่ต้องใส่เครื่องหมายคำพูด หากเว้นว่างจะไม่ตรวจรหัส (แต่ยังตรวจตัวเลข URL และคำภาษาอังกฤษเสมอ)
# PROTECTED_REGEX=\[[A-Z]{1,3}\d+[a-z]?\]
# บรรทัดที่แก้ไขแล้วต้องคล้ายต้นฉบับไม่น้อยกว่าค่านี้ (0–1) เพื่อป้องกันไม่ให้ LLM เขียนบรรทัดใหม่ทั้งหมด
# MIN_SIMILARITY=0.5
# จำนวนตัวอักษรสูงสุดของหนึ่งช่วงข้อความ (ระบบเริ่มช่วงใหม่ทุกครั้งที่พบหัวข้อด้วย)
# CHUNK_CHARS=3500
# จำนวนบรรทัดก่อนหลังที่ส่งไปเป็นบริบท (LLM ใช้ประกอบการพิจารณาเท่านั้น ไม่แก้ไข)
# CONTEXT_LINES=3

# --- workspace ---
# proofread_thai ต้องอ่านและเขียนไฟล์ชุดเดียวกับเอเจนต์ เลือกได้ 2 แบบ (ระบบเลือกให้เองตอนเริ่มทำงาน)
#   แบบที่ 1 (hermes) ผ่าน dashboard ของ Hermes ทาง HTTP: กำหนด HERMES_DASHBOARD_URL, _USER และ _PASSWORD ด้านล่าง
#            server นี้จึงอยู่คนละเครื่องกับ Hermes ได้
#   แบบที่ 2 (local) mount โฟลเดอร์ workspace: เปิด COMPOSE_FILE ในหมวด docker compose ด้านล่าง
#            ใช้เมื่ออยู่เครื่องเดียวกับเอเจนต์ หากมีโฟลเดอร์ที่ mount ไว้ ระบบจะใช้โฟลเดอร์ก่อนเสมอ
#   หากไม่กำหนดทั้งสองแบบ จะใช้ได้เฉพาะ proofread_text
# ที่อยู่ dashboard ของ Hermes เช่น http://hermes-dashboard:9119 (docker network เดียวกัน)
#   หรือ https://<เครื่องของ Hermes> เมื่ออยู่คนละเครื่อง (ควรใช้ HTTPS หรือ VPN)
# HERMES_DASHBOARD_URL=
# ชื่อผู้ใช้และรหัสผ่านสำหรับเข้า dashboard ของ Hermes (รหัสผ่านเป็นค่าลับ และเปิดสิทธิ์ทั้ง dashboard)
# HERMES_DASHBOARD_USER=
# HERMES_DASHBOARD_PASSWORD=
# โฟลเดอร์ workspace ภายใน Hermes ที่ใช้เป็นรากของ path ทั้งหมด
# HERMES_WORKSPACE=/opt/data/workspace

# --- การทำงานร่วมกับเอเจนต์ ---
# คำนำหน้า path ที่เอเจนต์อาจส่งมา ระบบจะตัดออกก่อนค้นหาไฟล์ (คั่นด้วย ,)
#   ใช้เมื่อเอเจนต์อ้างถึงไฟล์ด้วย path ภายในเครื่องของตัวเอง เช่น Hermes ส่ง /opt/data/workspace/report.md
#   สำหรับ Hermes ให้กำหนด /opt/data/workspace/ ไม่ว่าจะใช้ workspace แบบใด
# PATH_PREFIXES=
# ตำแหน่งที่เก็บไฟล์สำรองและบันทึกการแก้ไข
#   file = โฟลเดอร์เดียวกับไฟล์ที่แก้ไข · top = โฟลเดอร์ชั้นแรกใต้ workspace (รวมไว้ที่เดียวต่อหนึ่งโปรเจกต์)
# OUTPUT_PLACEMENT=file
# นามสกุลไฟล์ที่ proofread_thai แก้ไขได้ คั่นด้วย , (ระบบรองรับโครงสร้าง Markdown จึงเหมาะกับไฟล์ .md มากที่สุด)
# FILE_EXTENSIONS=.md
# ชื่อโฟลเดอร์ย่อยสำหรับเก็บไฟล์สำรอง (ปิดการสำรองไม่ได้ ทุกการแก้ไขจะมีไฟล์สำรองเสมอ)
# BACKUP_SUBDIR=backups
# ชื่อโฟลเดอร์ย่อยสำหรับเก็บบันทึกการแก้ไข หากเว้นว่างจะไม่เขียนบันทึก
# NOTES_SUBDIR=notes
# เขตเวลาที่ใช้ตั้งชื่อไฟล์สำรองและหัวข้อบันทึก ในรูปแบบ POSIX (image ไม่มี tzdata) เช่น <+00>0 สำหรับ UTC
# TZ=<+07>-7
# หากกำหนด เอเจนต์ต้องส่ง "Authorization: Bearer <ค่านี้>" ทุกครั้ง (ค่าลับ)
#   หากเว้นว่างจะไม่ตรวจสอบ ⚠ เมื่อเปิดพอร์ตให้เครื่องอื่นเข้าถึง ทุกคนในเครือข่ายจะสั่งแก้ไขไฟล์ใน workspace ได้
# MCP_AUTH_TOKEN=

# --- docker compose ---
# workspace แบบที่ 2 (local): เพิ่ม docker-compose.same-host.yml เพื่อ mount โฟลเดอร์ workspace
#   เมื่อกำหนดค่านี้ คำสั่ง docker compose ทุกคำสั่งจะใช้ทั้งสองไฟล์เอง บน Windows ให้คั่นด้วย ; แทน :
# COMPOSE_FILE=docker-compose.yml:docker-compose.same-host.yml
# โฟลเดอร์ workspace บนเครื่อง (ใช้เฉพาะแบบที่ 2 และ mount แบบเขียนได้ เพราะระบบต้องแก้ไขไฟล์)
# WORKSPACE_HOST_DIR=./workspace
# uid/gid ที่ container ใช้ ในแบบที่ 2 ควรตรงกับเจ้าของ workspace เพื่อให้ทั้งสองฝั่งยังเขียนไฟล์ที่แก้ไขแล้วได้
# RUN_UID=1000
# RUN_GID=1000
# docker network ที่ใช้ร่วมกับเอเจนต์ (ต้องสร้างก่อนด้วยคำสั่ง docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเข้าถึงได้ · 127.0.0.1 = เข้าถึงได้เฉพาะเครื่องนี้
# PUBLISH_ADDR=0.0.0.0
# พอร์ตบนเครื่อง
# PUBLISH_PORT=8805
